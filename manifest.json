{
  "manifest_version": 3,
  "name": "Auth Notes",
  "version": "0.1.0",
  "description": "Per-site encrypted notes about which auth method/2FA/email you used. Local only, no sync, no cloud.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Auth Notes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}